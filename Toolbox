local dragging, dragStart, startPos
FlyBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = FlyBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        FlyBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local UIVisible = true
FlyBtn.MouseButton1Click:Connect(function()
    UIVisible = not UIVisible
    pcall(function() Window:Toggle(UIVisible) end)
end)

--==================== LOAD FUNCTIONS ====================--
local InsertService = game:GetService("InsertService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function PlaceInFront(obj)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    pcall(function()
        if obj:IsA("Model") then
            obj:PivotTo(hrp.CFrame * CFrame.new(0, 0, -14))
        elseif obj:IsA("BasePart") then
            obj.CFrame = hrp.CFrame * CFrame.new(0, 0, -14)
        end
    end)
end

local function LoadAsset(id, name)
    id = tonumber(tostring(id):match("%d+"))
    if not id then
        NextUI:Error("Error", "ID tidak valid")
        return
    end

    local ok1, result1 = pcall(function()
        return InsertService:LoadAsset(id)
    end)

    if ok1 and result1 then
        result1.Name = name or ("Asset_" .. id)
        result1.Parent = workspace
        PlaceInFront(result1)
        NextUI:Success("Berhasil", (name or id) .. " (Metode 1)")
        return
    end

    local ok2, result2 = pcall(function()
        return game:GetObjects("rbxassetid://" .. id)
    end)

    if ok2 and result2 and #result2 > 0 then
        for _, obj in ipairs(result2) do
            obj.Name = name or ("Asset_" .. id)
            obj.Parent = workspace
            PlaceInFront(obj)
        end
        NextUI:Success("Berhasil", (name or id) .. " (Metode 2)")
        return
    end

    NextUI:Error("Gagal", "ID " .. id .. " tidak bisa di-load.")
end

local function LoadLocalFile(fileName)
    if not fileName or fileName == "" then
        NextUI:Error("Error", "Nama file tidak boleh kosong!")
        return
    end

    if not fileName:match("%.rbxm$") and not fileName:match("%.rbxl$") then
        fileName = fileName .. ".rbxm"
    end

    local success, result = pcall(function()
        if readfile and isfile and isfile(fileName) then
            local objects = game:GetObjects(getcustomasset and getcustomasset(fileName) or ("rbxassetid://"))
            if objects and #objects > 0 then
                for _, obj in ipairs(objects) do
                    obj.Parent = workspace
                    PlaceInFront(obj)
                end
                return true
            end
        end
        return false
    end)

    if success and result then
        NextUI:Success("Berhasil", "File " .. fileName .. " berhasil dimuat!")
    else
        local successLoad, loadedModel = pcall(function()
            return InsertService:LoadLocalAsset(fileName)
        end)
        
        if successLoad and loadedModel then
            loadedModel.Parent = workspace
            PlaceInFront(loadedModel)
            NextUI:Success("Berhasil", "File " .. fileName .. " berhasil dimuat!")
        else
            NextUI:Error("Gagal Load", "Taruh file di folder workspace eksekutor & pastikan format benar.")
        end
    end
end

